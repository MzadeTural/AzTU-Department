@using Kafedra.Application.DTOs.AccountDTOs;
@using Kafedra.Application.ViewModel.Account

@{
    Layout = null;
    ViewData["Title"] = "Giriş";
    
}
@model ForgotPasswordDTO


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" type="image/x-icon" href="~/assets/img/favicon4.png">
    <title>Giris</title>
    <!-- FONTS -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@300;400;700&display=swap"
          rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js" integrity="sha512-+NqPlbbtM1QqiK8ZAo4Yrj2c4lNQoGv8P79DPtKzj++l5jnN39rHA/xsqn8zE9l0uSoxaCdrOgFs6yjyfbBxSg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/core.js" integrity="sha512-yiGU7wGL2gatZdtlmCrEf4p+0rr5wA2eRZBxa9Amu4/ASYM5CQj/92HNYTqHR4s+5xk6cgCiZIpoCTVJqA0rAQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

    <!-- BOOTSTRAP    -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi"
          crossorigin="anonymous" />

    <!-- CUSTOM -->
    <link rel="stylesheet" href="~/assets/css/style.css" />

    
    <style>
        input {
            color: white !important;
        }

        .auth input[type=submit] {
            margin: auto;
        }

        .btn-5 {
            border-radius: 4px;
            border: none;
            background: rgb(255,27,0);
            background: linear-gradient(0deg, rgba(255,27,0,1) 0%, rgba(251,75,2,1) 100%);
            border: none;
            outline: none;
            color: white !important;
            padding: 11px 25px;
            width: 100px;
            border-radius: 4px;
            font-weight: 600;
            cursor: pointer;
        }
            .btn-5:hover {
                background: rgb(255,27,0);
                background: linear-gradient(0deg, rgba(255,27,0) 0%, rgba(231,45,2,1) 100%);
            }

    </style>
</head>

<body class="auth">
    <div class="auth--box" style="height: 410px;">
        <form id="myForm" method="post" class="auth--form">
            <div class="d-flex justify-content-center mb-3">
                <img src="~/assets/img/aztu_s_logo.png" class="w-25" />
            </div>
            <h2 class="fs-3">Yaxşı, gəl şifrəni dəyişdirək.</h2>
            <div style="padding-top: 2rem;padding-bottom: 1rem" asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div style="margin: 42px 0px 24px 5px;color:yellowgreen">
                <span class=" ">E-poçtunu daxil et.</span>
            </div>
            <div class="auth--inputBox">
                <input asp-for="Email" autocomplete="off" autocomplete="off" required="required">
                <span asp-validation-for="Email" class="text-danger error-span"></span>
                <p>E-poçt</p>
            </div>

            <div class="auth--links my-4">
                <a id="sendEmailBtn"><input class="btn-delete" type="submit" value="Davam et"></a>

                <a asp-action="Login" asp-controller="Account" class="btn-5">  Ləğv et</a>
            </div>


        </form>
    </div>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>  
        <script> 
        function showLoadingAlert() {
            let timerInterval
            Swal.fire({
                title: 'E-poçt göndərilir...',           
                timer: 20000,
                didOpen: () => {
                    Swal.showLoading()
                },
                willClose: () => {
                    clearInterval(timerInterval)
                }
            });
        }
        $(document).ready(function () {
       console.log("ads");
            $('#myForm').on('submit', function (e) {
                e.preventDefault(); // Prevent the default form submission
                showLoadingAlert();
                // Submit the form using AJAX
                $.ajax({
                    url: '@Url.Action("ForgotPassword", "Account")', // Replace with your controller action URL
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        Swal.close(); // Close the loading alert
                       
                        if (response.success) {
                            // Display SweetAlert for successful email sending
                            Swal.fire({
                                icon: 'success',
                                title: 'E-poçt göndərildi!',
                                text: 'Şifrə bərpa e-poçtu uğurla göndərildi.',
                                confirmButtonText: 'OK'
                            })
                            }else {
                            // Display SweetAlert for email sending failure
                            Swal.fire({
                                icon: 'error',
                                title: 'E-poçt göndərmək alınmadı!',
                                text: 'Ups, e-poçt göndərilərkən xəta baş verdi.',
                                confirmButtonText: 'OK'
                            });
                        }
                       
                    },
                    error: function () {
                        // Display SweetAlert for general error
                        Swal.fire({
                            icon: 'error',
                            title: 'Oops...',
                            text: 'Something went wrong!',
                            confirmButtonText: 'OK'
                        });
                    }
                            
                });
              
            });
     
        
        });          
            </script>
    
 

    

   
    @section scripts {

        <script src="https://kit.fontawesome.com/7c8b79bb9f.js" crossorigin="anonymous"></script>
        <!--==Bootstrap==-->
        <script src="https://cdn.jsdelivr.net/npm/jquery@3.5.1/dist/jquery.slim.min.js"
                integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj"
                crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"
                integrity="sha384-fQybjgWLrvvRgtW6bFlB7jaZrFsaBXjsOMm/tB9LTS58ONXgqbR9W8oWht/amnpF"
                crossorigin="anonymous"></script>
        <!--==MainJs==-->
        < !--Toastr-- >
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        
        }
          
        </body>
</html>