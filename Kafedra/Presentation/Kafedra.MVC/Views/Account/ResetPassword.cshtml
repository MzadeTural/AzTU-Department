<body class="auth">
    <div class="auth--box" style="height: 570px;">
        <form id="myForm" method="post" class="auth--form">
            <div class="d-flex justify-content-center mb-3">
                <img src="~/assets/img/aztu_s_logo.png" class="w-25" />
            </div>
            <h2 class="fs-3">
                İndi yeni şifrə
               <br/> təyin et.
            </h2>
            <div style="padding-top: 2rem;padding-bottom: 1rem" asp-validation-summary="ModelOnly" class="text-danger"></div>
           
            <div style="margin: 42px 0px 24px 5px;color:yellowgreen">
                <span class=" ">Şifrəni 2 dəfə daxil edərək yeniləyə bilərsən.</span>
            </div>
            <div class="auth--inputBox">
                <input asp-for="Password" id="id_password" required="required">
                <i class="fas fa-eye fa-eye-slash" id="togglePassword" style="bottom: 12px;position: absolute;/* right: 7%; */right: 0;/* top: 45%; */cursor: pointer;z-index:10;color:white" aria-hidden="true"></i>
                <p>Şifrə</p>
            </div>
                <span asp-validation-for="Password" class="text-danger error-span"></span>
            <div class="auth--inputBox">
                <input asp-for="ConfirmPassword" id="id_passwordc" required="required">
                <i class="fas fa-eye fa-eye-slash" id="togglePasswordc" style="bottom: 12px;position: absolute;/* right: 7%; */right: 0;/* top: 45%; */cursor: pointer;z-index:10;color:white" aria-hidden="true"></i>
                <p>Şifrəni Təsdiqləyin</p>
            </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger error-span"></span>

            <div class="auth--links my-4">
                <a id="changePasswordButton"><input class="btn-delete" type="submit" value="Davam et"></a>

                <a asp-action="Login" asp-controller="Account" class="btn-5">  Ləğv et</a>
            </div>

           
        </form>
    </div>
    <script src="https://kit.fontawesome.com/7c8b79bb9f.js" crossorigin="anonymous"></script>


    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

       <link href = "https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel = "stylesheet" >
   



       

