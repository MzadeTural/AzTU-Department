    <style>

        @@media screen and (max-width: 990px) {
            .content-wrapper {
                margin: 0 !important;
            }
        }
        ::-webkit-scrollbar {
            width: 0px;
           
        }

        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        ::-webkit-scrollbar-thumb {
            background: #888;
        }

        :root {
            --bg: #e0e0e0;
        }

        .dark-mod {
            outline: none;
            border: none;
        }

        .switch {
            position: relative;
            display: inline-block;
            left: 50%;
            top: 175%;
            transform: translateX(45%) translateY(-205%);
            width: 80px;
            height: 33px;
        }

            .switch .dark-mod {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .darkslider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #27173a;
            -webkit-transition: .4s;
            transition: .4s;
        }

            .darkslider:before {
                position: absolute;
                content: "";
                height: 25px;
                 width: 25px;
                left: 4px;
                bottom: 4px;
                background-color: #f9c20a;
                -webkit-transition: .4s;
                transition: .4s;
            }

            .darkslider:after {
                background-color: #27173a;
                content: "";
                position: absolute;
                border-radius: 50%;
                left: -20px;
                bottom: 4px;
                width: 25px;
                opacity: 0;
                height: 25px;
                -webkit-transition: .2s;
                transition: .2s;
            }

        .dark-mod:checked + .darkslider:after {
            left: auto;
            opacity: 1;
            -webkit-transform: translateX(40px);
            -ms-transform: translateX(40px);
            transform: translateX(40x);
            -webkit-transition: .5s;
            transition: .5s;
        }

        .dark-mod:checked + .darkslider {
            background-color: #27173a;
        }

        .dark-mod:focus + .darkslider {
            box-shadow: 0 0 1px #2196F3;
        }

        .dark-mod:checked + .darkslider:before {
            /*background: transparent;
          box-shadow: 25px 0px 0px 0px #f9c20a;*/
            -webkit-transform:translateX(45px);
            -ms-transform: translateX(45px);
            transform: translateX(45px);
        }

        .darkslider.round {
            border-radius: 34px;
        }

            .darkslider.round:before {
                border-radius: 50%;
            }
            .toast-top-full-width {
            width:20% !important;
            }

    </style>
