
@{
    ViewData["Title"] = "Index";
}

<!-- component -->
@using Kafedra.Application.DTOs.Users;
@model List<UsersGetDto>


    <style>
    .sticky {
        position: fixed;
        top: 0; /* or bottom: 0; if you want to stick to the bottom */
        z-index: 10;
        width: 87% !important;
    }

    .sticky-button {
        position: fixed !important;
        left: 12% !important;
        z-index: 11 !important;
    }

    .sticky-search {
        position: fixed !important;
        z-index: 11;
    }

    .search-box {
        width: fit-content;
        height: fit-content;
        position: absolute;
        right: 2%;
         top: 24px;
        
    }

    .input-search {
        height: 50px;
        width: 50px;
        border-style: none;
        padding: 10px;
        font-size: 18px;
        letter-spacing: 2px;
        outline: none;
        border-radius: 25px;
        transition: all .5s ease-in-out;
        background-color: #22a6b3;
        padding-right: 40px;
        color: #fff;
    }

        .input-search::placeholder {
            color: rgba(255,255,255,.5);
            font-size: 18px;
            letter-spacing: 2px;
            font-weight: 100;
        }

    .btn-search {
        width: 50px;
        height: 50px;
        border-style: none;
        font-size: 20px;
        font-weight: bold;
        outline: none;
        cursor: pointer;
        border-radius: 50%;
        position: absolute;
        right: 0px;
        color: #ffffff;
        background-color: transparent;
        pointer-events: painted;
    }

        .btn-search:focus ~ .input-search {
            width: 300px;
            border-radius: 0px;
            border-radius: 10px;
            background-color: transparent;
            border: 1px solid rgba(255,255,255,.5);
            transition: all 500ms cubic-bezier(0, 0.110, 0.35, 2);
        }

    .input-search:focus {
        width: 300px;
        border-radius: 0px;
        border-radius: 10px;
        background-color: transparent;
        border: 1px solid rgba(255,255,255,.5);
        transition: all 500ms cubic-bezier(0, 0.110, 0.35, 2);
    }

    .action-td {
        display: flex;
        height: 252px;
        position: relative;
        justify-content: space-around;
        flex-direction: column;
    }

    .btn-create {
        color: white;
        position: absolute;
        background: #32de84;
        width: 50px;
        height: 50px;
        border-radius: 25px;
        /* text-align: center; */
        align-items: center;
        display: flex;
        justify-content: center;
        left: 2%;
        top: 24px;
    }

        .btn-create:hover {
            color: white;
        }

    #statusElement {
        width: 4rem;
    }
        tr{
        text-align: center;
        }
        td{
        vertical-align: middle !important
        }
    </style>
<div class="content-wrapper">
