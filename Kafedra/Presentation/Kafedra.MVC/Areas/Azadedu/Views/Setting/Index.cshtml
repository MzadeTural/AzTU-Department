@model PagenatedListDto<Setting>

@{
    int count = (Model.PageIndex - 1) * Model.PageSize + 1;
}

<style>
   
</style>

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12">
                    <h1 style="    background: #0E205B;
                                    color: white;
                                    padding: 5px;
                                    border-radius: 10px;
                                    text-align:center;">
                        Settings
                    </h1>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="row">
                        <div class="col-lg-12">
                            @if(Model.HasItems){
                                
                            <table class="table table-striped projects">
                                <thead class="thead-dark">
                                    <tr>
                                        <th scope="col">No</th>
                                        <th scope="col">Key</th>
                                        <th scope="col">Value</th>
                                        <th scope="col">
                                            Image 
                                        </th>
                                        <th>
                                            Action 
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Setting item in Model)
                                    {
                                        <tr>
                                            <th scope="row" style=" vertical-align: middle;">@(count++)</th>
                                            <td>@(item.Key.Contains("image") || item.Key.Contains("count") ? item.Key.Substring(0, item.Key.Length - 6) : item.Key)</td>
                                            @if (@item.Key.Contains("count"))
                                            {
                                                <td style="width:40%;font-size:3rem">
                                                    @item.Value
                                                </td>
                                            }else{
                                            <td style="width:40%">
                                                @Html.Raw(item.Value.Length>100?item.Value.Substring(0,100):item.Value)
                                            </td>
                                            }
                                            @if (item.Key.Contains("image"))
                                            {
                                                <td>
                                                    <div class="image-box" style="background:#002147;display:flex;justify-content:center;width:103px;height:103px;padding-top: 1px;">
                                                        <img src="~/uploads/settings/@item.Value" style="width:100px;height:100px;object-fit:contain;" />
                                                    </div>
                                                </td>
                                            }
                                            else
                                            {
                                                <td>
                                                    <div class="image-box" style="background:#002147;display:flex;justify-content:center;width:103px;height:103px;padding-top: 1px;color:white">
                                                            <span style="text-align: center; align-items: center;display: flex;">Təsvir<br> ehtiva<br> etmir </span>
                                                    </div>
                                                </td>
                                            }
                                            <td>
                                                <a asp-action="edit" asp-route-id="@item.Id" class="btn btn-outline-info">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            } 
                            else
                            {
                            @await Html.PartialAsync("_NoResultItemPartial")

                            }

                            @await Html.PartialAsync("_PaginationPartial")
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>