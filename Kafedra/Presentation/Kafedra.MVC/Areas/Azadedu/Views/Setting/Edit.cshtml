@{
    ViewData["Title"] = "Edit";
}

@model Setting
<link href="toastr.css" rel="stylesheet" />
<style>
    /*-------------------- Mixins ---------------------*/
    /*-------------------- Body ---------------------*/
    *, *::before, *::after {
        box-sizing: border-box;
    }

    /*-------------------- setting Card ---------------------*/
    .setting-card {
        width: 600px;
        position: absolute;
      
        left: 50%;
        transform: translate(-50%, 0%);
        background: #f5f5f5;
        box-shadow: 0 10px 20px rgba(0, 0, 0, .3);
        overflow: hidden;
        border-radius: 5px;
        padding: 25px;
        text-align: center;
        z-index: 2;
    }

        .setting-card figure {
            margin: 0;
            padding: 0;
            overflow: hidden;
            outline: none !important;
        }

            .setting-card figure img {
                height: 300px;
                object-fit: contain;
                width: 100%;
                background: #002147;
                padding: 5px;
            }

        .setting-card .title {
            font-weight: 900;
            text-transform: uppercase;
            font-size: 30px;
            color: #23211f;
            margin-bottom: 5px;
        }

        .setting-card .desc {
            font-size: 17px;
            opacity: 0.8;
            margin-bottom: 3px;
        }

        .setting-card .cta {
            padding: 20px 20px 5px;
        }

            .setting-card .cta::after {
                content: '';
                display: table;
                clear: both;
            }

        .setting-card .price {
            float: left;
            color: #ff3100;
            font-size: 22px;
            font-weight: 900;
            padding-top: 2px;
            transition: color 0.3s ease-in-out;
            margin-top: 4px;
        }

        .setting-card .btn {
            position: relative;
            z-index: 1;
            float: right;
            display: inline-block;
            font-size: 13px;
            font-weight: 900;
            text-transform: uppercase;
            color: #ff3100;
            padding: 12px 18px;
            cursor: pointer;
            transition: all 0.3s ease-in-out;
            line-height: 0.95;
            border: none;
            background: none;
            outline: none;
            border: 1px solid #ff3100;
            border-radius: 20px;
            overflow: hidden;
        }

            .setting-card .btn .bg {
                width: 101%;
                height: 101%;
                display: block !important;
                z-index: -1;
                opacity: 0;
                transition: all 0.3s ease-in-out;
                background: linear-gradient(135deg, #a61322, #d33f34);
            }

            .setting-card .btn:hover {
                color: #002147 !important;
                border: 1px solid #002147 !important;
            }

                .setting-card .btn:hover .bg {
                    opacity: 1;
                }
    /*-------------------- Slick Dots ---------------------*/
    .slick-dots {
        bottom: -30px;
    }

        .slick-dots a {
            position: relative;
            display: block;
            width: 16px;
            height: 16px;
        }

        .slick-dots span {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 6px;
            height: 6px;
            border-radius: 50%;
        }

        .slick-dots circle {
            fill: none;
            stroke-width: 1;
            stroke-linecap: round;
            stroke-dasharray: 39 39;
            stroke-dashoffset: 39;
            transition: all 0.9s ease-in-out;
            transition: stroke-dashoffset 0.5s;
        }

        .slick-dots .slick-active circle {
            stroke-dashoffset: 0;
        }
    /*-------------------- Background --------------------*/
    .bg {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 100%;
        height: 100%;
        background: linear-gradient(15deg, #d33f34 50%, #a61322 50.1%);
        z-index: 1;
        display: none;
    }

    .the-most {
        position: fixed;
        z-index: 1;
        bottom: 0;
        left: 0;
        width: 50vw;
        max-width: 200px;
        padding: 10px;
    }

        .the-most img {
            max-width: 100%;
        }
</style>
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-12" style="padding: 20px; display: flex; justify-content: center; align-items: center;">
                    <h1>Update Setting Data</h1>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
    
    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">

                    <form method="post" enctype="multipart/form-data">

                        <input asp-for="Key" type="hidden" class="form-control">

                        <div class="setting-card" id="SettingCard">
                            <div class="title">
                                @Model.Key
                            </div>
                            @if (Model.Key.Contains("image"))
                            {
                                <div class="slider">

                                    <figure data-color="#292a2f, #131519">
                                        <span class="text-danger"></span>
                                        <img id="image" src="~/uploads/settings/@Model.Value" />
                                    </figure>
                                </div>

                                <div class="cta">

                                    <input asp-for="ImageFile" value="~/uploads/settings/@Model.Value" id="fileInput" class="btn form-control img-upload-input">
                                    <button type="submit" class="btn btn-primary my-3 toastrDefaultInfo Inconceivable!">Submit</button>
                                </div>
                            }
                            else if (Model.Key.Contains("count"))
                            {
                               

                                <div class="cta">
                                    <div class="price">Value</div>
                                    <input asp-for="NumValue" class=" form-control">
                                    <button type="submit" class="btn btn-primary my-3">Submit</button>
                                </div>
                            }
                            else
                            {
                               

                                <div class="cta">
                                    <label asp-for="Value" class="form-label">Value</label>
                                    <textarea asp-for="Value" class="form-control" id="editor" rows="3"></textarea>
                                    <button type="submit" class="btn btn-primary my-3">Submit</button>
                                </div>
                            }
                        </div>

                    </form>

                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->
</div>


@section Scripts{
    <script src="https://cdn.ckeditor.com/ckeditor5/32.0.0/classic/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#editor'))
            .catch(error => {
                console.error(error);
            });
    </script>
    <script>

      
        

        const fileInput = document.getElementById('fileInput');
        const imageElement = document.getElementById('image');
        const span = document.getElementsByClassName('text-danger');

        window.addEventListener('DOMContentLoaded', (event) => {
            console.log("Ad");
            // Get the file input element
            const fileInput = document.getElementById('fileInput');
            const val = 'wwwroot/uploads/settings/'+@Model.Value;
            // Set the default file value
            fileInput.files[0] = val;
        });

        fileInput.addEventListener('change', function () {
            const selectedFile = fileInput.files[0];

            if (selectedFile) {
                const objectURL = URL.createObjectURL(selectedFile);
                
                imageElement.src = objectURL;
                span[0].innerHTML="* Yeni Şəkil Seçibsiniz"
            } else {
                imageElement.src = ''; // Clear the image source if no file is selected
            }
        });


    </script>
}
